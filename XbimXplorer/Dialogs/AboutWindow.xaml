<Window x:Class="XbimXplorer.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AboutWindow" Height="340" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" WindowStyle="None"
        Deactivated="AboutWindow_OnDeactivated"
        MouseLeftButtonDown="UserControl_MouseLeftButtonDown" Icon="pack://siteoforigin:,,,/Invicara.ico"
        >
    <Border Padding="5" BorderBrush="Black" BorderThickness="1">
        <Grid >

            
            <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="IPA IfcXplorer" VerticalAlignment="Top" FontSize="24" />
            <TextBlock Margin="10,42,0,0" TextWrapping="Wrap">Application to generate Invicara Platform package file from IFC using Xbim</TextBlock>
            <TabControl Margin="10,65,10,10">
                <TabItem Header="Application">
                    <StackPanel Margin="10" >
                        <TextBlock Margin="0,3" TextWrapping="Wrap" >
                            This application uses xBIM toolkit, which is an Open Source software initiative to help software developers and researchers to support the next generation of BIM tools. Notice on xBIM license can be found here:
                        </TextBlock>
                        <TextBlock Margin="0,3" >
                            <Hyperlink RequestNavigate="Link_RequestNavigate" NavigateUri="https://github.com/xBimTeam/XbimEssentials/blob/master/LICENCE.md">
					            <TextBlock Text="https://github.com/xBimTeam/XbimEssentials/blob/master/LICENCE.md"/>
				            </Hyperlink>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,3" Text="{Binding AppVersion}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,3" Text="The original source codes for Xbim can be found here:" />
                        <TextBlock Margin="0,3" >
                            <Hyperlink RequestNavigate="Link_RequestNavigate" NavigateUri="https://github.com/xbimteam">
					            <TextBlock Text="https://github.com/xbimteam"/>
				            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,3" ><Hyperlink RequestNavigate="Link_RequestNavigate" NavigateUri="https://github.com/Invicara/XbimWindowsUI"><InlineUIContainer>
                           <TextBlock Text="https://github.com/Invicara/XbimWindowsUI"/>
                        </InlineUIContainer></Hyperlink></TextBlock>
                        <TextBlock Margin="0,3" ><Hyperlink RequestNavigate="Link_RequestNavigate" NavigateUri="https://github.com/Invicara/XbimGeometry"><InlineUIContainer>
                           <TextBlock Text="https://github.com/Invicara/XbimGeometry"/>
                        </InlineUIContainer></Hyperlink></TextBlock>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Assemblies"  GotFocus="LoadAssemblies" >
                    <TextBox x:Name="AssembliesText" VerticalScrollBarVisibility="Auto" Margin="10" Text="" />
                </TabItem>
                <TabItem Header="Model">
                    <TextBox VerticalScrollBarVisibility="Auto" Margin="10" Text="{Binding ModelInfo, Mode=OneWay}" />
                </TabItem>
            </TabControl>

            <Image x:Name="Logo" HorizontalAlignment="right" Height="64" Margin="441,10,10,0" VerticalAlignment="Top" Width="64" Stretch="Fill"/>


        </Grid>
    </Border>

</Window>
