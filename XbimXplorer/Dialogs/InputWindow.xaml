<Window x:Class="XbimXplorer.Dialogs.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPA IfcXplorer" 
        Height="170" Width="400"
        Icon="pack://siteoforigin:,,,/Invicara.ico"
        WindowStartupLocation="CenterOwner"
        ContentRendered="Window_ContentRendered"
        >
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Label Margin="5">Please input federation name :</Label>
        <TextBox Name="txtModelName" Grid.Row="1" Height="23" Margin="5">Default Project Name</TextBox>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button IsDefault="True" Name="btnOk" Click="btnOk_Click" MinWidth="60" Margin="0,0,10,0">_Ok</Button>
            <Button IsCancel="True" MinWidth="60">_Cancel</Button>
        </WrapPanel>
    </Grid>
</Window>
